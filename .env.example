# FutureReady environment settings -- copy to .env and fill in.
# Every variable here mirrors a field on config.py's Settings class.

# Upload directory (relative to project root)
UPLOAD_DIR=uploads

# Max upload file size in megabytes (documents vs. video recordings)
MAX_FILE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=300

# Frames sampled per video for the pose analyzer. This is a floor:
# services/self_practice_manager.py raises it automatically to hit the
# context profile's min_sample_rate_hz (see extractors/video_extractor.py).
VIDEO_SAMPLE_FRAME_COUNT=60

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Session persistence (PostgreSQL). Uses the psycopg3 driver.
DATABASE_URL=postgresql+psycopg://futureready:futureready@localhost:5432/futureready

# Accounts (Nhom B): HS256 signing secret for access tokens
# (utils/security.py). REQUIRED -- token issue/verify fails loudly if unset;
# there is deliberately no insecure default. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
